<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginBottom="24dp" />

        <!-- Schedule section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_schedule" />

        <LinearLayout
            android:id="@+id/rowOffTime"
            style="@style/SettingRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/off_time_label" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/off_time_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOffTime"
                style="@style/RowValue"
                android:text="23:00" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowOnTime"
            style="@style/SettingRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="@string/on_time_label" />
                <TextView
                    style="@style/RowSubtitle"
                    android:text="@string/on_time_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOnTime"
                style="@style/RowValue"
                android:text="07:00" />
        </LinearLayout>

        <!-- Targets section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_targets" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchWifi"
            style="@style/SettingSwitch"
            android:text="@string/toggle_wifi" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchData"
            style="@style/SettingSwitch"
            android:text="@string/toggle_data" />

        <!-- Mode section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_mode" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAccessibility"
            style="@style/SettingSwitch"
            android:text="@string/accessibility_mode" />

        <TextView
            style="@style/RowSubtitle"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/accessibility_explanation" />

        <TextView
            android:id="@+id/tvAccessibilityStatus"
            style="@style/RowSubtitle"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/accessibility_off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAccessibility"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/open_accessibility_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExactAlarm"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/request_exact_alarm" />

        <!-- Master switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEnable"
            style="@style/SettingSwitch"
            android:text="@string/enable_schedule"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/RowSubtitle"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/disabled_status" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_button" />
    </LinearLayout>
</ScrollView>
